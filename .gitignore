# Credentials never belong here — this repo is public. Real secrets live in
# ~/.config/identilock-dev/ (mode 600). These patterns are a backstop against
# a stray copy, not the storage mechanism.
*.pem
*.p8
*.p12
*.pfx
*-sftp
*credentials*
*secret*
.env
.env.*

# Process material stays local — trackers, runbooks, dev tooling, and brand
# source are working files, not part of the published project.
/docs/
/DEPLOY.md
/brand/
/tools/
/splash--splash-d_cropped.svg
